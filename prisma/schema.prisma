datasource db {
  provider = "sqlite"
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Todo {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  title String
  description String?
}

model FoundItem {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  name       String
  location   String
  roomNumber String?
  notes      String?
  status     String    @default("waiting") // "waiting" | "claimed"
  claimedAt  DateTime?
}
